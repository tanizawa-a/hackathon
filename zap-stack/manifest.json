{
  "manifest_version": 3,
  "name": "Zap Stack",
  "version": "0.1.0",
  "description": "Stack YouTube videos as small overlay players and watch them simultaneously.",
  "permissions": ["contextMenus", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["video-id.js", "content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["frame-main.js"],
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
